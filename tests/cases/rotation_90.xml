<?xml version="1.0" encoding="utf-8"?>
<!--
  Reuses the imu-orientations data with a non-zero sensor-to-OpenSim rotation.

  Every shipped example uses <rotation>0. 0. 0.</rotation>, under which the
  degrees-to-radians conversion is a no-op, so nothing else exercises that path.
  This case exists so a regression there (it was applied in radians once) is
  caught. Paths are relative to this file, as everywhere else.
-->
<inverseKinematicsSetup version="1.0">
  <modelFilePath>../../examples/imu-orientations/model.osim</modelFilePath>
  <orientations>
    <filePath>../../examples/imu-orientations/orientations.sto</filePath>
    <weights>
      <orientationWeight name="femur_r_imu">1</orientationWeight>
      <orientationWeight name="tibia_r_imu">1</orientationWeight>
      <orientationWeight name="femur_l_imu">1</orientationWeight>
      <orientationWeight name="tibia_l_imu">1</orientationWeight>
    </weights>
    <rotation>0. 0. 90.</rotation>
  </orientations>
  <resultsOutputPath>../../examples/imu-orientations/ik_rotation90.sto</resultsOutputPath>
  <useVisualizer>false</useVisualizer>
  <constraintWeight>10</constraintWeight>
  <solverAccuracy>1e-05</solverAccuracy>
</inverseKinematicsSetup>
