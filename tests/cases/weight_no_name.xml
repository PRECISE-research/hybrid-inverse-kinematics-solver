<?xml version="1.0" encoding="utf-8"?>
<!-- A weight entry with no name attribute. This used to dereference null.
     The nonexistent model then fails the run fast, so the test stays quick. -->
<inverseKinematicsSetup version="1.0">
  <modelFilePath>./does_not_exist.osim</modelFilePath>
  <markers>
    <filePath>./does_not_exist.trc</filePath>
    <weights>
      <markerWeight>1</markerWeight>
    </weights>
  </markers>
</inverseKinematicsSetup>
