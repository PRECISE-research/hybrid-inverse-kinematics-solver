      <markerWeight name="LMFC">250</markerWeight>
      <markerWeight name="RKJC">1</markerWeight>
      <markerWeight name="LKJC">1</markerWeight>
      <markerWeight name="RTIB1">100</markerWeight>
      <markerWeight name="LTIB1">100</markerWeight>
      <markerWeight name="RTIB2">100</markerWeight>
      <markerWeight name="LTIB2">100</markerWeight>
      <markerWeight name="RTIB3">100</markerWeight>
      <markerWeight name="LTIB3">100</markerWeight>
      <markerWeight name="RTIB4">100</markerWeight>
      <markerWeight name="LTIB4">100</markerWeight>
      <markerWeight name="RLMAL">1000</markerWeight>
      <markerWeight name="LLMAL">1000</markerWeight>
      <markerWeight name="RMMAL">0</markerWeight>
      <markerWeight name="LMMAL">0</markerWeight>
      <markerWeight name="RAJC">1</markerWeight>
